{
  "name": "@hellosz/dsh-pets",
  "version": "0.3.1",
  "description": "DeepSeek Harness pet companion — Codex Pets style floating pet with notification broadcasting and a pet_say tool",
  "type": "module",
  "main": "dsh-pets.mjs",
  "exports": {
    ".": "./dsh-pets.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "files": [
    "dsh-pets.mjs",
    "cordis.patch.yml",
    "lib/client.js",
    "packs",
    "README.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "*",
    "react": "^18.2.0 || ^19.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hellosz/dsh-pets.git"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "pet",
    "petdex",
    "codex-pets"
  ],
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "scripts": {
    "test": "node --check dsh-pets.mjs && node --check lib/client.js"
  }
}
